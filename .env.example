# Adesh OS local demo environment
# Copy to .env and adjust as needed.

# Control plane
ADESH_BIND_ADDR=127.0.0.1:7777
ADESH_ROOT_OWNER_TOKEN=demo-root-owner-token
ADESH_DATABASE_URL=sqlite://adesh.db?mode=rwc

# Model provider profile
# Use `fake` for deterministic local demos without LM Studio.
# Use `lm_studio` for live local model inference.
ADESH_MODEL_PROVIDER_BACKEND=fake
ADESH_MODEL_PROVIDER_BASE_URL=http://127.0.0.1:1234
ADESH_MODEL_PROVIDER_MODEL=qwen3.5-27b
ADESH_MODEL_PROVIDER_TIMEOUT_SECONDS=180

# Tool providers (keep fake for non-destructive demos)
ADESH_EMAIL_PROVIDER_BACKEND=fake
ADESH_WEBHOOK_PROVIDER_BACKEND=fake

# Optional throttling/retry tuning
ADESH_RATE_LIMIT_WINDOW_SECONDS=30
ADESH_RATE_LIMIT_MAX_REQUESTS=120
ADESH_SYSCALL_RETRY_ATTEMPTS=2
